# Example environment file for syncfusion-a2ui-examples.
#
# Copy this file to `.env` inside the `examples/` directory and fill in your
# own values. The example scripts load it automatically from their own
# directory — they DO NOT read the ADK's root `.env`.
#
#     cp examples/.env.example examples/.env

# ---- Azure OpenAI ------------------------------------------------------------
# Used by every example agent in this folder.
AZURE_API_KEY=your-azure-openai-api-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2025-01-01-preview
# MODEL_NAME may be a litellm-style "<provider>/<deployment>"; the examples
# strip the prefix automatically.
MODEL_NAME=azure/your-deployment-name

# ---- Syncfusion Platform MCP -------------------------------------------------
# Read by the Syncfusion React Assistant MCP server as `Syncfusion_API_Key`.
Syncfusion_API_Key=your-syncfusion-api-key

# Set to "1" to register the Syncfusion React Platform MCP at boot.
# Requires Node.js + npx on PATH.
SYNCFUSION_REACT_MCP_AVAILABLE=1

# ---- Local Skills -----------------------------------------------------------
# Absolute path to the directory that contains skill sub-directories.
# Each sub-directory must have a SKILL.md with YAML front-matter
# (name + description). Skills are evaluated BEFORE the MCP server.
# Leave unset (or empty) to disable skill routing entirely.
SKILLS_PATH=

# ---- Other providers (optional) ---------------------------------------------
# GOOGLE_API_KEY=your-google-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
